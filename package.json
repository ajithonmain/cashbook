{
  "name": "cashbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "admin": "node scripts/admin.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:e2e": "node tests/e2e/api.e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "idb": "^8.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9",
    "wrangler": "^3.90.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true,
    "core-js@3.51.0": true
  },
  "description": "Offline-first CashBook / ledger PWA. Self-host on your own Cloudflare account.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajithonmain/cashbook.git"
  },
  "homepage": "https://github.com/ajithonmain/cashbook#readme",
  "bugs": {
    "url": "https://github.com/ajithonmain/cashbook/issues"
  }
}
